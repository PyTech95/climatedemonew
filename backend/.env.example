# Copy this file to backend/.env and fill it in.

# MongoDB connection string. Local server:  mongodb://localhost:27017
# MongoDB Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net
MONGO_URL=mongodb://localhost:27017
MONGO_DB=prisha_boutique

# Long random string used to sign admin login tokens. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-going-live-use-a-long-random-string

# Demo mode: creates sample data on first start, shows the demo logins on the
# staff sign-in page, and lets the super admin reset the data. Use false for a real shop.
DEMO_MODE=true
DEMO_ADMIN_PASSWORD=demo123

# Real shop only (DEMO_MODE=false): the first super admin, created when there are no admins yet.
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_PASSWORD=

# Razorpay keys. Leave empty to use the built-in test payment screen.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Only needed when the React app is hosted on a different address from this API.
CORS_ORIGINS=http://localhost:5173
